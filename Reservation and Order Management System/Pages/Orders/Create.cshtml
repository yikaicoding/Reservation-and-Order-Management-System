@page
@model Reservation_and_Order_Management_System.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Order food";
    ViewData["BodyClass"] = "order-page";
    var email = User.Identity?.Name ?? "Signed-in account";
    var avatarLetter = string.IsNullOrWhiteSpace(email) ? "G" : email[..1].ToUpperInvariant();
}

<div class="profile-app">
    <aside class="profile-sidebar" aria-label="Main navigation">
    <a class="profile-brand" asp-page="/Index" aria-label="Q Dine home">
        <span class="brand-mark">Q</span>
        <span>Q<span class="brand-light">Dine</span></span>
    </a>

    <div class="sidebar-label">YOUR ACCOUNT</div>

    <nav class="profile-nav">
        <a asp-page="/Index"><span class="nav-icon">&#8962;</span><span>Home</span></a>
        <a asp-page="/Reservations/Create">
            <span class="nav-icon">&#9638;</span><span>Reservations</span>
        </a>
        <a class="active" asp-page="/Orders/Create" aria-current="page">
            <span class="nav-icon">&#9827;</span><span>Order food</span></a>
        <a asp-page="/Profile"><span class="nav-icon">&#9881;</span><span>Profile &amp; Settings</span></a>
    </nav>

    <div class="sidebar-spacer"></div>

    <div class="sidebar-user">
        <span class="user-avatar">@avatarLetter</span>
        <span class="sidebar-user-copy">
            <strong>@email</strong>
            <small>Customer account</small>
        </span>
    </div>

    <form method="post" asp-page="/Account/Logout" class="sidebar-logout">
        <button type="submit"><span class="nav-icon">&#8618;</span>Log out</button>
    </form>
</aside>

    <main class="profile-main">
        <section class="profile-hero">
            <div class="hero-copy">
                <span class="eyebrow"><span class="eyebrow-dot"></span> YOUR DINING EXPERIENCE</span>
                <h1>Order food for your visit.</h1>
                <p>Choose a confirmed reservation and tell us what you’d like ready at your table.</p>
            </div>
            <div class="hero-account">
                <span class="hero-avatar">@avatarLetter</span>
                <span>
                    <strong>@email</strong>
                    <small>Orders are linked to your reservation</small>
                </span>
                <span class="verified-pill"><span>●</span> CUSTOMER</span>
            </div>
            <span class="hero-orb hero-orb-one"></span>
            <span class="hero-orb hero-orb-two"></span>
        </section>

        <div class="profile-content">
            <div class="profile-heading-row">
                <div>
                    <h2>Build your order</h2>
                    <p>Submit up to three items for one of your upcoming confirmed reservations.</p>
                </div>
                <div class="secure-label"><span>✓</span> SECURE ORDER</div>
            </div>

            <div class="profile-columns order-columns">
                <section class="profile-card order-form-card">
                    <div class="card-heading">
                        <span class="card-icon blue-icon">♧</span>
                        <div>
                            <h3>Reservation &amp; food items</h3>
                            <p>Choose where to attach this order and add your items.</p>
                        </div>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="All" class="order-validation" role="alert"></div>

                        <label asp-for="ReservationId" class="form-label order-label">
                            Confirmed reservation
                        </label>
                        <select asp-for="ReservationId" class="form-select order-input">
                            <option value="">Choose an upcoming reservation</option>

                            @foreach (var reservation in Model.Reservations)
                            {
                                <option value="@reservation.ReservationId">
                                    @reservation.StartsAt.ToString("ddd, MMM d · h:mm tt")
                                    — Table #@reservation.RestaurantTableId
                                </option>
                            }
                        </select>

                        @if (Model.Reservations.Count == 0)
                        {
                            <p class="order-empty">
                                You have no eligible reservations yet. A future confirmed reservation is needed before you can order.
                            </p>
                        }

                        <div class="order-items-heading">
                            <div>
                                <h3>What would you like?</h3>
                                <p>Add up to three food items.</p>
                            </div>
                            <span class="order-count">UP TO 3 ITEMS</span>
                        </div>

                        @for (var i = 0; i < 3; i++)
                        {
                            var line = Model.Lines != null && Model.Lines.Count > i
                                ? Model.Lines[i]
                                : null;

                            <div class="order-line">
                                <label class="order-label" for="Lines_@(i)__ItemName">Item @(i + 1)</label>
                                <input id="Lines_@(i)__ItemName"
                                       name="Lines[@i].ItemName"
                                       value="@line?.ItemName"
                                       class="form-control order-input"
                                       maxlength="100"
                                       placeholder="e.g. Grilled chicken salad" />

                                <label class="order-label quantity-label" for="Lines_@(i)__Quantity">Qty</label>
                                <input id="Lines_@(i)__Quantity"
                                       name="Lines[@i].Quantity"
                                       type="number"
                                       min="1"
                                       max="50"
                                       value="@(line?.Quantity ?? 1)"
                                       class="form-control order-input quantity-input" />
                            </div>
                        }

                        <button class="btn order-submit"
                                type="submit"
                                disabled="@(Model.Reservations.Count == 0)">
                            Submit food order <span>→</span>
                        </button>
                    </form>
                </section>

                <aside class="profile-secondary-column order-aside">
                    <section class="profile-card">
                        <div class="card-heading">
                            <span class="card-icon mint-icon">✓</span>
                            <div>
                                <h3>How it works</h3>
                                <p>A few details before you submit.</p>
                            </div>
                        </div>

                        <div class="order-step">
                            <span>1</span>
                            <div>
                                <strong>Choose a reservation</strong>
                                <small>Only your future confirmed visits are available.</small>
                            </div>
                        </div>
                        <div class="order-step">
                            <span>2</span>
                            <div>
                                <strong>Add your food items</strong>
                                <small>Enter an item name and quantity for each line.</small>
                            </div>
                        </div>
                        <div class="order-step">
                            <span>3</span>
                            <div>
                                <strong>Submit your order</strong>
                                <small>One food order is allowed per reservation.</small>
                            </div>
                        </div>
                    </section>

                    <section class="profile-card order-note-card">
                        <div class="card-heading">
                            <span class="card-icon orange-icon">i</span>
                            <div>
                                <h3>Need to make a change?</h3>
                                <p>Contact the restaurant if you need help with an order.</p>
                            </div>
                        </div>
                    </section>
                </aside>
            </div>
        </div>
    </main>
</div>

@section Styles {
    <style>
        .order-page {
            margin: 0;
            min-height: 100vh;
            background: #f3f6fb;
            color: #17243a;
            font-family: Inter, "Segoe UI", Arial, sans-serif;
        }

        .order-page main {
            padding: 0 !important;
        }

        .order-page .alert {
            position: fixed;
            z-index: 20;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 8px 24px #10264a22;
        }

        .order-columns {
            grid-template-columns: minmax(0, 1.55fr) minmax(250px, .9fr);
        }

        .order-form-card {
            padding: 20px;
        }

        .order-label {
            display: block;
            margin: 0 0 6px;
            color: #59667a;
            font-size: 10px;
            font-weight: 700;
        }

        .order-input {
            min-height: 40px;
            border-color: #dce3ed;
            border-radius: 8px;
            background-color: #f9fbfe;
            color: #29374e;
            font-size: 11px;
        }

        .order-input:focus {
            border-color: #5891ee;
            background-color: #fff;
            box-shadow: 0 0 0 3px #1768e817;
        }

        .order-empty {
            margin: 8px 0 0;
            padding: 10px 12px;
            border-radius: 8px;
            background: #fff7e9;
            color: #91651c;
            font-size: 10px;
        }

        .order-items-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin: 24px 0 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eef1f5;
        }

        .order-items-heading h3 {
            margin: 0 0 3px;
            color: #29364b;
            font-size: 12px;
            font-weight: 750;
        }

        .order-items-heading p {
            margin: 0;
            color: #929daf;
            font-size: 9px;
        }

        .order-count {
            padding: 5px 8px;
            border-radius: 20px;
            background: #edf4ff;
            color: #3476dc;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .4px;
            white-space: nowrap;
        }

        .order-line {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 74px;
            align-items: end;
            gap: 6px 11px;
            margin-bottom: 13px;
        }

        .order-line .order-label:first-child {
            grid-column: 1;
            margin-bottom: -2px;
        }

        .order-line .quantity-label {
            grid-column: 2;
            grid-row: 1;
            margin-bottom: -2px;
        }

        .order-line .quantity-input {
            grid-column: 2;
            grid-row: 2;
        }

        .order-line > input:first-of-type {
            grid-column: 1;
            grid-row: 2;
        }

        .order-submit {
            display: flex;
            width: 100%;
            min-height: 42px;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 19px;
            border: 0;
            border-radius: 8px;
            background: linear-gradient(105deg, #1971f4, #084dbc);
            color: #fff;
            font-size: 11px;
            font-weight: 750;
            box-shadow: 0 5px 12px #1664dd2b;
        }

        .order-submit:hover {
            background: linear-gradient(105deg, #0f62df, #073f9f);
            color: #fff;
        }

        .order-submit:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

        .order-validation:empty {
            display: none;
        }

        .order-validation {
            margin-bottom: 14px;
            padding: 10px 12px;
            border: 1px solid #f2c7c5;
            border-radius: 8px;
            background: #fff5f5;
            color: #a83530;
            font-size: 10px;
        }

        .order-step {
            display: flex;
            gap: 10px;
            padding: 12px 0;
            border-top: 1px solid #eef1f5;
        }

        .order-step > span {
            display: grid;
            width: 24px;
            height: 24px;
            flex: 0 0 auto;
            place-items: center;
            border-radius: 8px;
            background: #edf4ff;
            color: #3178e9;
            font-size: 10px;
            font-weight: 800;
        }

        .order-step > div {
            display: grid;
            gap: 4px;
        }

        .order-step strong {
            color: #3c485c;
            font-size: 10px;
        }

        .order-step small {
            color: #929daf;
            font-size: 9px;
            line-height: 1.5;
        }

        .order-note-card {
            background: #fffdfa;
        }

        @@media (max-width: 900px) {
            .order-columns {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @@media (max-width: 600px) {
            .order-form-card {
                padding: 15px;
            }

            .order-line {
                grid-template-columns: minmax(0, 1fr) 64px;
                gap: 6px 8px;
            }
        }
    </style>
}