@page
@model Reservation_and_Order_Management_System.Pages.Account.RegisterModel

<h1>Create customer account</h1>

<form method="post" class="col-md-6">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <label asp-for="FullName" class="form-label">Full name</label>
    <input asp-for="FullName" class="form-control" />

    <label asp-for="Email" class="form-label mt-2">Email</label>
    <input asp-for="Email" class="form-control" />

    <label asp-for="Password" class="form-label mt-2">Password</label>
    <input asp-for="Password" class="form-control" />

    <label asp-for="ConfirmPassword" class="form-label mt-2">
        Confirm password
    </label>
    <input asp-for="ConfirmPassword" class="form-control" />

    <button type="submit" class="btn btn-primary mt-3">Register</button>
</form>

<p class="mt-3">
    Already registered?
    <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">
        Sign in
    </a>
</p>