@page
@model Reservation_and_Order_Management_System.Pages.Customer.DashboardModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard - QDine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="d-flex min-vh-100">

        <!-- ===== Sidebar ===== -->
        <nav class="qd-sidebar bg-white d-flex flex-column p-3">

            <a class="qd-logo-blue mb-4 px-2" asp-page="/Customer/Dashboard">
                <i class="bi bi-fork-knife"></i> QDine
            </a>

            <a class="qd-nav-link" asp-page="/Customer/Menu">
                <i class="bi bi-grid"></i> Menu
            </a>
            <a class="qd-nav-link" asp-page="/Customer/ReserveTable">
                <i class="bi bi-book"></i> Reservation
            </a>
            <a class="qd-nav-link" asp-page="/Customer/Cart">
                <i class="bi bi-cart"></i> Cart
            </a>
            <a class="qd-nav-link" asp-page="/Customer/MyReservation">
                <i class="bi bi-clock-history"></i> Order History
            </a>

            <div class="mt-auto">
                <a class="qd-nav-link" asp-page="/Customer/Profile">
                    <i class="bi bi-gear"></i> Profile &amp; Settings
                </a>
                <a class="qd-nav-link text-danger" asp-page="/Customer/Logout">
                    <i class="bi bi-box-arrow-left"></i> Log out
                </a>
            </div>
        </nav>


        <!-- ===== Main content ===== -->
        <main class="flex-grow-1">

            <!-- Blue banner -->
            <div class="qd-bg-blue text-white p-5">
                <span class="badge rounded-pill bg-white bg-opacity-25 mb-3">
                    <i class="bi bi-person"></i> YOUR QDINE ACCOUNT
                </span>
                <h1 class="fw-bold">@Model.Greeting, @Model.CustomerName.</h1>
                <p class="fs-5 mb-0">What would you like to do today?</p>
            </div>

            <!-- Quick action cards -->
            <div class="container-fluid p-4">
                <div class="row g-4">

                    <div class="col-md-6 col-xl-3">
                        <a asp-page="/Customer/ReserveTable" class="card qd-card h-100 text-decoration-none text-dark">
                            <div class="card-body">
                                <i class="bi bi-calendar-check fs-2 text-primary"></i>
                                <h5 class="fw-bold mt-2">Book a table</h5>
                                <p class="text-muted small mb-0">Pick your date, time and table.</p>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <a asp-page="/Customer/Menu" class="card qd-card h-100 text-decoration-none text-dark">
                            <div class="card-body">
                                <i class="bi bi-journal-text fs-2 text-primary"></i>
                                <h5 class="fw-bold mt-2">Browse menu</h5>
                                <p class="text-muted small mb-0">See dishes and order ahead.</p>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <a asp-page="/Customer/MyReservation" class="card qd-card h-100 text-decoration-none text-dark">
                            <div class="card-body">
                                <i class="bi bi-clock-history fs-2 text-primary"></i>
                                <h5 class="fw-bold mt-2">My history</h5>
                                <p class="text-muted small mb-0">Past reservations and orders.</p>
                            </div>
                        </a>
                    </div>

                    <div class="col-md-6 col-xl-3">
                        <a asp-page="/Customer/Profile" class="card qd-card h-100 text-decoration-none text-dark">
                            <div class="card-body">
                                <i class="bi bi-person-gear fs-2 text-primary"></i>
                                <h5 class="fw-bold mt-2">My profile</h5>
                                <p class="text-muted small mb-0">Update details and preferences.</p>
                            </div>
                        </a>
                    </div>

                </div>
            </div>
        </main>
    </div>

</body>
</html>