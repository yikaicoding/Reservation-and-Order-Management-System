@page
@model Reservation_and_Order_Management_System.Pages.Customer.RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create your account - QDine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="row g-0 min-vh-100">

        <!-- ===== Left blue panel ===== -->
        <div class="col-lg-5 qd-bg-blue text-white p-5 d-flex flex-column">

            <a class="qd-logo" asp-page="/Customer/Login">
                <i class="bi bi-fork-knife"></i> QDine
            </a>

            <p class="text-uppercase small fw-bold mt-5 mb-2 opacity-75">Your table is waiting</p>

            <h1 class="fw-bold mb-3">
                Every great meal starts with a <span class="text-qd-orange">seat at the table.</span>
            </h1>

            <p class="opacity-75 mb-4">
                Create your QDine account to reserve faster, remember your favourites,
                and make every visit feel personal.
            </p>

            <ul class="list-unstyled">
                <li class="mb-3">
                    <i class="bi bi-calendar-check me-2"></i>
                    <strong>Book in seconds</strong>
                    <div class="small opacity-75 ms-4">Your details stay ready for the next reservation.</div>
                </li>
                <li class="mb-3">
                    <i class="bi bi-heart me-2"></i>
                    <strong>Save your favourites</strong>
                    <div class="small opacity-75 ms-4">Keep the dishes and dining spaces you love close.</div>
                </li>
                <li class="mb-3">
                    <i class="bi bi-stars me-2"></i>
                    <strong>Make every visit yours</strong>
                    <div class="small opacity-75 ms-4">Thoughtful preferences, remembered by QDine.</div>
                </li>
            </ul>
        </div>


        <!-- ===== Right form side ===== -->
        <div class="col-lg-7 d-flex align-items-center justify-content-center p-4">

            <div class="card qd-card w-100" style="max-width: 620px;">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-1">Create your account</h2>
                    <p class="text-muted small mb-4">
                        One account for quicker bookings, saved favourites, and dining that feels made for you.
                    </p>

                    <form method="post">

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="Customer.FullName" class="form-label small fw-bold">Full name</label>
                            <div class="input-group qd-input">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Customer.FullName" class="form-control" placeholder="Enter your full name" />
                            </div>
                            <span asp-validation-for="Customer.FullName" class="text-danger small"></span>
                        </div>

                        <div class="row">

                            <!-- Email -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Customer.Email" class="form-label small fw-bold">Email address</label>
                                <div class="input-group qd-input">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Customer.Email" type="email" class="form-control" placeholder="you@example.com" />
                                </div>
                                <span asp-validation-for="Customer.Email" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Customer.Phone" class="form-label small fw-bold">Phone number</label>
                                <div class="input-group qd-input">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <select asp-for="CountryCode" class="form-select" style="max-width: 85px;">
                                        <option value="+60">+60</option>
                                        <option value="+65">+65</option>
                                        <option value="+62">+62</option>
                                        <option value="+66">+66</option>
                                    </select>
                                    <input asp-for="Customer.Phone" type="tel" class="form-control" placeholder="12-345 6789" />
                                </div>
                                <span asp-validation-for="Customer.Phone" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Customer.Password" class="form-label small fw-bold">Password</label>
                                <div class="input-group qd-input">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Customer.Password" type="password" id="password" class="form-control" placeholder="At least 8 characters" />
                                    <button type="button" class="btn border" onclick="togglePassword('password', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Customer.Password" class="text-danger small"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirm password</label>
                                <div class="input-group qd-input">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" id="confirmPassword" class="form-control" placeholder="Repeat your password" />
                                    <button type="button" class="btn border" onclick="togglePassword('confirmPassword', this)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                        </div>

                        <p class="text-muted small">Use 8+ characters with at least one number.</p>

                        <!-- Terms -->
                        <div class="form-check mb-3">
                            <input asp-for="AgreeTerms" class="form-check-input" type="checkbox" />
                            <label asp-for="AgreeTerms" class="form-check-label small">
                                I agree to QDine's <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                            </label>
                            <div><span asp-validation-for="AgreeTerms" class="text-danger small"></span></div>
                        </div>

                        <button type="submit" class="btn btn-qd w-100">Create account</button>
                    </form>

                    <p class="text-center small mt-3 mb-0">
                        Already part of QDine? <a asp-page="/Customer/Login" class="fw-bold text-decoration-none">Sign in</a>
                    </p>

                    <hr />
                    <p class="text-center text-muted small mb-0">
                        <i class="bi bi-lock"></i> Your personal information is kept private and never shared without permission.
                    </p>

                </div>
            </div>
        </div>
    </div>

    <script>
        //Show or hide password
        function togglePassword(id, btn) {
            var input = document.getElementById(id);
            var show = input.type === "password";
            input.type = show ? "text" : "password";
            btn.querySelector("i").className = show ? "bi bi-eye-slash" : "bi bi-eye";
        }
    </script>

</body>
</html>