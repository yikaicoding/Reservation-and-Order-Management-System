@page
@model Reservation_and_Order_Management_System.Pages.Customer.MyReservationModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order History - QDine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="d-flex min-vh-100">

        <!-- ===== Sidebar ===== -->
        <nav class="qd-sidebar bg-white d-flex flex-column p-3">

            <a class="qd-logo-blue mb-4 px-2" asp-page="/Customer/Dashboard">
                <i class="bi bi-fork-knife"></i> QDine
            </a>

            <a class="qd-nav-link" asp-page="/Customer/Dashboard"><i class="bi bi-house"></i> Home</a>
            <a class="qd-nav-link" asp-page="/Customer/Menu"><i class="bi bi-grid"></i> Menu</a>
            <a class="qd-nav-link" asp-page="/Customer/ReserveTable"><i class="bi bi-book"></i> Reservation</a>
            <a class="qd-nav-link" asp-page="/Customer/Cart"><i class="bi bi-cart"></i> Cart</a>
            <a class="qd-nav-link active" asp-page="/Customer/MyReservation"><i class="bi bi-clock-history"></i> Order History</a>

            <div class="mt-auto">
                <a class="qd-nav-link" asp-page="/Customer/Profile"><i class="bi bi-gear"></i> Profile &amp; Settings</a>
                <a class="qd-nav-link text-danger" asp-page="/Customer/Logout"><i class="bi bi-box-arrow-left"></i> Log out</a>
            </div>
        </nav>


        <!-- ===== Main ===== -->
        <main class="flex-grow-1">

            <!-- Blue banner -->
            <div class="qd-bg-blue text-white px-5 pt-5 pb-5">
                <span class="badge rounded-pill bg-white bg-opacity-25 mb-3">
                    <i class="bi bi-clock-history"></i> @Model.TotalVisits VISITS
                </span>
                <h1 class="fw-bold">Your dining history.</h1>
                <p class="fs-5 mb-0">Upcoming tables and every visit so far, all in one place.</p>
            </div>

            <div class="container-fluid px-4 qd-overlap">

                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }


                <!-- ===== Upcoming ===== -->
                <div class="card qd-card mb-4">
                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-1">Upcoming</h4>
                        <p class="text-muted small mb-4">Your next reservations.</p>

                        @if (Model.Upcoming.Count == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-calendar-x fs-1"></i>
                                <p class="mt-2 mb-3">No upcoming reservations.</p>
                                <a asp-page="/Customer/ReserveTable" class="btn btn-qd px-4">Book a table</a>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var r in Model.Upcoming)
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <div class="border rounded-3 p-3 h-100">

                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="qd-table-badge p-0 border-0 bg-transparent">
                                                    <span>T@(r.RestaurantTableId.ToString("00"))</span>
                                                    <div>
                                                        <div class="fw-bold">@r.ReservationDate.ToString("ddd, d MMM yyyy")</div>
                                                        <small class="text-muted">
                                                            @DateTime.Today.Add(r.ReservationTime).ToString("h:mm tt") ·
                                                            @r.NumberOfGuests guests
                                                        </small>
                                                    </div>
                                                </div>
                                                <span class="badge @MyReservationModel.StatusBadge(r.Status)">@r.Status</span>
                                            </div>

                                            <!-- US06 preferences -->
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @if (!string.IsNullOrEmpty(r.SeatingPreference))
                                                {
                                                    <span class="badge rounded-pill text-bg-light border">
                                                        <i class="bi bi-geo-alt"></i> @r.SeatingPreference
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(r.Occasion))
                                                {
                                                    <span class="badge rounded-pill text-bg-light border">
                                                        <i class="bi bi-gift"></i> @r.Occasion
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(r.DietaryRequirements))
                                                {
                                                    <span class="badge rounded-pill qd-pill-orange">
                                                        <i class="bi bi-exclamation-circle"></i> @r.DietaryRequirements
                                                    </span>
                                                }
                                            </div>

                                            @if (!string.IsNullOrEmpty(r.SpecialRequests))
                                            {
                                                <p class="small text-muted mt-2 mb-0">
                                                    <i class="bi bi-chat-left-text"></i> @r.SpecialRequests
                                                </p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>


                <!-- ===== Past ===== -->
                <div class="card qd-card">
                    <div class="card-body p-4">

                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                            <div>
                                <h4 class="fw-bold mb-1">Past visits</h4>
                                <p class="text-muted small mb-0">Every reservation you've made with us.</p>
                            </div>

                            <!-- Filter tabs -->
                            <div class="btn-group">
                                <a asp-route-filter="All"
                                   class="btn btn-sm @(Model.Filter == "All" ? "btn-primary" : "btn-outline-primary")">All</a>
                                <a asp-route-filter="Completed"
                                   class="btn btn-sm @(Model.Filter == "Completed" ? "btn-primary" : "btn-outline-primary")">Completed</a>
                                <a asp-route-filter="Cancelled"
                                   class="btn btn-sm @(Model.Filter == "Cancelled" ? "btn-primary" : "btn-outline-primary")">Cancelled</a>
                            </div>
                        </div>

                        @if (Model.Past.Count == 0)
                        {
                            <p class="text-muted text-center py-4 mb-0">No past reservations to show.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Table</th>
                                            <th>Guests</th>
                                            <th>Preferences</th>
                                            <th>Status</th>
                                            <th>Review</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.Past)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@r.ReservationDate.ToString("d MMM yyyy")</td>
                                                <td>@DateTime.Today.Add(r.ReservationTime).ToString("h:mm tt")</td>
                                                <td>T@(r.RestaurantTableId.ToString("00"))</td>
                                                <td>@r.NumberOfGuests</td>
                                                <td class="small text-muted">
                                                    @(r.SeatingPreference ?? "-")
                                                    @if (!string.IsNullOrEmpty(r.Occasion))
                                                    {
                                                        <span>· @r.Occasion</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge @MyReservationModel.StatusBadge(r.Status)">@r.Status</span>
                                                </td>

                                                <!-- US12: review stars or button -->
                                                <td>
                                                    @if (Model.Ratings.ContainsKey(r.ReservationId))
                                                    {
                                                        int stars = Model.Ratings[r.ReservationId];
                                                        <span class="text-qd-orange" title="@stars out of 5">
                                                            @(new string('★', stars))@(new string('☆', 5 - stars))
                                                        </span>
                                                    }
                                                    else if (r.Status != "Cancelled")
                                                    {
                                                        <a asp-page="/Customer/Review" asp-route-id="@r.ReservationId"
                                                           class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-star"></i> Leave review
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </main>
    </div>

</body>
</html>