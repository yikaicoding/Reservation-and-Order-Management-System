@page
@model Reservation_and_Order_Management_System.Pages.Customer.ConfirmationModel
@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-4">
    <!-- Wizard Step Bar -->
    <div class="d-flex justify-content-center align-items-center mb-4 text-center">
        <div class="badge rounded-circle bg-success text-white p-3 me-2">1</div> <span class="me-4 fw-semibold text-muted">Select Details</span>
        <div class="badge rounded-circle bg-success text-white p-3 me-2">2</div> <span class="me-4 fw-semibold text-muted">Pick Table</span>
        <div class="badge rounded-circle bg-success text-white p-3 me-2">3</div> <span class="me-4 fw-semibold text-muted">Preferences</span>
        <div class="badge rounded-circle bg-primary text-white p-3 me-2">4</div> <span class="fw-bold text-primary">Confirm</span>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg text-center p-4">
                <div class="text-success display-3 mb-2">
                    <i class="bi bi-check-circle-fill"></i> &#10004;
                </div>
                <h3 class="fw-bold mb-1">Reservation Confirmed!</h3>
                <p class="text-muted mb-4">Your table has been reserved. Please present this voucher upon arrival.</p>

                <div class="bg-light p-3 rounded text-start mb-4 border">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Booking Reference:</span>
                        <strong class="text-primary">#RES-@Model.CurrentReservation.ReservationId</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Table:</span>
                        <strong>Table @Model.ReservedTable.TableNumber (@Model.ReservedTable.DiningArea)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Date & Time:</span>
                        <strong>@Model.CurrentReservation.ReservationDate.ToString("yyyy-MM-dd") (@Model.CurrentReservation.TimeSlot)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Guests:</span>
                        <strong>@Model.CurrentReservation.NumberOfGuests pax</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CurrentReservation.SpecialRequests))
                    {
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Requests:</span>
                            <span class="small text-end">@Model.CurrentReservation.SpecialRequests</span>
                        </div>
                    }
                </div>

                <div class="d-grid gap-2">
                    <a asp-page="/Customer/ReserveTable" class="btn btn-primary fw-bold py-2">Make Another Booking</a>
                </div>
            </div>
        </div>
    </div>
</div>