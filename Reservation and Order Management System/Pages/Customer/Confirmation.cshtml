@page
@model Reservation_and_Order_Management_System.Pages.Customer.ConfirmationModel
@{
    ViewData["Title"] = "Reservation Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-5">
                    <div class="mb-4 text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l5-6.02a.75.75 0 0 0-.05-1.07z" />
                        </svg>
                    </div>
                    <h2 class="fw-bold mb-2">Reservation Confirmed!</h2>
                    <p class="text-muted mb-4">Your table booking has been successfully recorded in our system.</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mb-4" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a href="/Customer/ReserveTable" class="btn btn-outline-primary px-4">Book Another Table</a>
                        <button onclick="window.print()" class="btn btn-primary px-4">Print Voucher</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
