@page
@model Reservation_and_Order_Management_System.Pages.Customer.DiningPreferencesModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dining Preferences - QDine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="d-flex min-vh-100">

        <!-- ===== Sidebar ===== -->
        <nav class="qd-sidebar bg-white d-flex flex-column p-3">

            <a class="qd-logo-blue mb-4 px-2" asp-page="/Customer/Dashboard">
                <i class="bi bi-fork-knife"></i> QDine
            </a>

            <a class="qd-nav-link" asp-page="/Customer/Dashboard"><i class="bi bi-house"></i> Home</a>
            <a class="qd-nav-link" asp-page="/Customer/Menu"><i class="bi bi-grid"></i> Menu</a>
            <a class="qd-nav-link active" asp-page="/Customer/ReserveTable"><i class="bi bi-book"></i> Reservation</a>
            <a class="qd-nav-link" asp-page="/Customer/Cart"><i class="bi bi-cart"></i> Cart</a>
            <a class="qd-nav-link" asp-page="/Customer/MyReservation"><i class="bi bi-clock-history"></i> Order History</a>

            <div class="mt-auto">
                <a class="qd-nav-link" asp-page="/Customer/Profile"><i class="bi bi-gear"></i> Profile &amp; Settings</a>
                <a class="qd-nav-link text-danger" asp-page="/Customer/Logout"><i class="bi bi-box-arrow-left"></i> Log out</a>
            </div>
        </nav>


        <!-- ===== Main ===== -->
        <main class="flex-grow-1">

            <!-- Blue banner with stepper -->
            <div class="qd-bg-blue text-white px-5 pt-4 pb-5">

                <div class="qd-stepper mb-4">
                    <div class="qd-step done"><span><i class="bi bi-check-lg"></i></span>Select Details</div>
                    <div class="qd-step done"><span><i class="bi bi-check-lg"></i></span>Pick Table</div>
                    <div class="qd-step active"><span>3</span>Dining Preferences</div>
                    <div class="qd-step"><span>4</span>Confirm Booking</div>
                </div>

                <h1 class="fw-bold">Make it yours.</h1>
                <p class="fs-5 mb-0">Tell us how you like to dine, and we'll have it ready.</p>
            </div>

            <div class="container-fluid px-4 qd-overlap">

                <!-- Error -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @Model.ErrorMessage
                        <a asp-page="/Customer/ReserveTable" class="alert-link">Back to Reservation</a>
                    </div>
                }

                <form method="post">

                    <!-- Booking details from step 1 & 2 -->
                    <input type="hidden" asp-for="Date" />
                    <input type="hidden" asp-for="Time" />
                    <input type="hidden" asp-for="Guests" />
                    <input type="hidden" asp-for="TableId" />

                    <div class="row g-4">

                        <!-- ===== Preferences card ===== -->
                        <div class="col-lg-8">
                            <div class="card qd-card">
                                <div class="card-body p-4">

                                    <h4 class="fw-bold mb-1">Dining preferences</h4>
                                    <p class="text-muted small mb-4">All optional. Skip anything that doesn't matter to you.</p>

                                    <!-- Seating -->
                                    <h6 class="fw-bold">Preferred seating</h6>
                                    <div class="d-flex flex-wrap gap-2 mb-4">
                                        <input type="radio" class="btn-check" name="SeatingPreference" id="seatNone" value=""
                                               checked="@string.IsNullOrEmpty(Model.SeatingPreference)" />
                                        <label class="btn qd-chip" for="seatNone">No preference</label>

                                        @for (int i = 0; i < DiningPreferencesModel.SeatingOptions.Length; i++)
                                        {
                                            var option = DiningPreferencesModel.SeatingOptions[i];
                                            <input type="radio" class="btn-check" name="SeatingPreference" id="seat@(i)" value="@option"
                                                   checked="@(Model.SeatingPreference == option)" />
                                            <label class="btn qd-chip" for="seat@(i)">@option</label>
                                        }
                                    </div>

                                    <!-- Occasion -->
                                    <h6 class="fw-bold">Special occasion</h6>
                                    <div class="d-flex flex-wrap gap-2 mb-4">
                                        <input type="radio" class="btn-check" name="Occasion" id="occNone" value=""
                                               checked="@string.IsNullOrEmpty(Model.Occasion)" />
                                        <label class="btn qd-chip" for="occNone">None</label>

                                        @for (int i = 0; i < DiningPreferencesModel.OccasionOptions.Length; i++)
                                        {
                                            var option = DiningPreferencesModel.OccasionOptions[i];
                                            <input type="radio" class="btn-check" name="Occasion" id="occ@(i)" value="@option"
                                                   checked="@(Model.Occasion == option)" />
                                            <label class="btn qd-chip" for="occ@(i)">@option</label>
                                        }
                                    </div>

                                    <!-- Dietary (pick many) -->
                                    <h6 class="fw-bold">
                                        Dietary requirements
                                        <span class="text-qd-orange small fw-normal">Shared with the kitchen</span>
                                    </h6>
                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                        @for (int i = 0; i < DiningPreferencesModel.DietaryOptions.Length; i++)
                                        {
                                            var option = DiningPreferencesModel.DietaryOptions[i];
                                            <input type="checkbox" class="btn-check" name="Dietary" id="diet@(i)" value="@option"
                                                   checked="@Model.Dietary.Contains(option)" />
                                            <label class="btn qd-chip qd-chip-orange" for="diet@(i)">@option</label>
                                        }
                                    </div>
                                    <input asp-for="OtherDietary" class="form-control mb-1"
                                           placeholder="Other allergies or needs (optional)" />
                                    <span asp-validation-for="OtherDietary" class="text-danger small"></span>

                                    <!-- Special requests -->
                                    <h6 class="fw-bold mt-4">Special requests</h6>
                                    <textarea asp-for="SpecialRequests" class="form-control" rows="3" maxlength="500"
                                              placeholder="e.g. Celebrating an anniversary, a quiet table is appreciated."></textarea>
                                    <span asp-validation-for="SpecialRequests" class="text-danger small"></span>

                                </div>
                            </div>
                        </div>


                        <!-- ===== Booking summary card ===== -->
                        <div class="col-lg-4">
                            <div class="card qd-card">
                                <div class="card-body p-4">

                                    <h4 class="fw-bold mb-1">Booking summary</h4>
                                    <p class="text-muted small mb-4">Review your details before continuing.</p>

                                    @if (Model.TableId > 0)
                                    {
                                        <p class="mb-2"><i class="bi bi-calendar3 text-primary me-2"></i>@Model.Date.ToString("dddd, d MMMM yyyy")</p>
                                        <p class="mb-2"><i class="bi bi-clock text-primary me-2"></i>@DateTime.Today.Add(Model.Time).ToString("h:mm tt")</p>
                                        <p class="mb-3"><i class="bi bi-people text-primary me-2"></i>@Model.Guests people</p>

                                        <div class="qd-table-badge mb-4">
                                            <span>T@(Model.TableId.ToString("00"))</span>
                                            <div>
                                                <small class="text-qd-orange fw-bold">SELECTED TABLE</small>
                                                <div class="fw-bold">Table @Model.TableId</div>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex gap-2">
                                        <a asp-page="/Customer/ReserveTable" class="btn btn-outline-primary flex-fill">Back</a>
                                        <button type="submit" class="btn btn-qd flex-fill" disabled="@(Model.TableId <= 0)">
                                            Continue to Confirm
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </main>
    </div>

</body>
</html>