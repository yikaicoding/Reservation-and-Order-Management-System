<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Reservation and Order Management System</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet"
          href="~/Reservation_and_Order_Management_System.styles.css"
          asp-append-version="true" />
</head>

@{
    var bodyClass = ViewData["BodyClass"]?.ToString() ?? "";
    var isProfilePage = bodyClass == "profile-page";
    var isBookingPage = bodyClass == "booking-page";
    var isOrderPage = ViewData["BodyClass"]?.ToString() == "order-page";
    var isStandalonePage = isProfilePage || isBookingPage || isOrderPage;
}

<body class="@bodyClass">
    @if (!isStandalonePage)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">
                        Reservation and Order Management System
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Profile">My profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Reservations/Create">Book</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Orders/Create">Order food</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Staff/Reservations">Staff</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (isProfilePage || isBookingPage || isOrderPage)
    {
        @if (TempData["Message"] is string profileMessage)
        {
            <div class="alert alert-success">@profileMessage</div>
        }
        @RenderBody()
    }

    @if (isStandalonePage)
    {
        @if (TempData["Message"] is string standaloneMessage)
        {
            <div class="alert alert-success">@standaloneMessage</div>
        }

        @RenderBody()
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-success">@message</div>
                }

                @RenderBody()
            </main>
        </div>
    }

    @if (!isStandalonePage)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Reservation and Order Management System -
                <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>