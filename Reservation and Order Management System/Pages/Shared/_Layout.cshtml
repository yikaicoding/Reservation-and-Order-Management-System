@{
    //Which page are we on? e.g. "/Customer/ReserveTable"
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    //Highlight the sidebar link for the current page
    string Active(params string[] pages) => pages.Any(p => current.StartsWith(p)) ? "active" : "";

    //Staff and Admin pages don't get the customer sidebar
    bool showSidebar = !current.StartsWith("/Admin") && !current.StartsWith("/Staff");

    var headerTitle = ViewData["HeaderTitle"]?.ToString();
    var headerSubtitle = ViewData["HeaderSubtitle"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QDine</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
        @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">

    <div class="d-flex min-vh-100">

        @if (showSidebar)
        {
            <!-- ===== Sidebar ===== -->
            <nav class="qd-sidebar bg-white d-flex flex-column p-3">

                <a class="qd-logo-blue mb-4 px-2" asp-page="/Customer/Dashboard">
                    <i class="bi bi-fork-knife"></i> QDine
                </a>

                <a class="qd-nav-link @Active("/Customer/Dashboard")" asp-page="/Customer/Dashboard"><i class="bi bi-house"></i> Home</a>
                <a class="qd-nav-link @Active("/Customer/Menu")" asp-page="/Customer/Menu"><i class="bi bi-grid"></i> Menu</a>
                <a class="qd-nav-link @Active("/Customer/ReserveTable", "/Customer/DiningPreferences", "/Customer/BookingSummary", "/Customer/ReviewBooking", "/Customer/Confirmation", "/Customer/Voucher", "/Reservations")" asp-page="/Customer/ReserveTable"><i class="bi bi-book"></i> Reservation</a>
                <a class="qd-nav-link @Active("/Customer/Cart", "/Customer/Checkout", "/Customer/PaymentSuccess", "/Customer/Receipt", "/Orders")" asp-page="/Orders/Create"><i class="bi bi-cart"></i> Cart</a>
                <a class="qd-nav-link @Active("/Customer/MyReservation", "/Customer/Review")" asp-page="/Customer/MyReservation"><i class="bi bi-clock-history"></i> Order History</a>

                <div class="mt-auto">
                    <a class="qd-nav-link @Active("/Customer/Profile")" asp-page="/Customer/Profile"><i class="bi bi-gear"></i> Profile &amp; Settings</a>
                    <a class="qd-nav-link text-danger" asp-page="/Customer/Logout"><i class="bi bi-box-arrow-left"></i> Log out</a>
                </div>
            </nav>
        }

        <!-- ===== Main ===== -->
        <main class="flex-grow-1">

            <!-- Blue banner (only if the page sets HeaderTitle) -->
            @if (!string.IsNullOrEmpty(headerTitle))
            {
                <div class="qd-bg-blue text-white px-5 pt-5 pb-5">
                    <h1 class="fw-bold">@headerTitle</h1>
                    @if (!string.IsNullOrEmpty(headerSubtitle))
                    {
                        <p class="fs-5 mb-0 opacity-75">@headerSubtitle</p>
                    }
                </div>
            }

            <!-- Page content -->
            <div class="container-fluid p-4">
                @RenderBody()
            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>