@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QDine</title>

    https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css

    ~/css/site.css
</head>
<body>

    <div class="app-layout">

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="logo">
                <a asp-page="/Index">QDine</a>
            </div>

            <nav class="sidebar-nav">

                <a asp-page="/Menu/Index">Menu</a>

                <a asp-page="/Reservation/Index">Reservation</a>

                <a asp-page="/Cart/Index">Cart</a>

                <a asp-page="/OrderHistory/Index">Order History</a>

                <a asp-page="/Profile/Index">Profile</a>

            </nav>

        </aside>

        <!-- Main -->
        <div class="main-container">

            <!-- Page Header -->
            <header class="hero-header">

                <div>
                    <h1>
                        @(ViewData["HeaderTitle"] ?? "QDine")
                    </h1>

                    <p>
                        @(ViewData["HeaderSubtitle"] ?? "")
                    </p>
                </div>

            </header>

            <!-- Dynamic Content -->
            <main class="page-content">
                @RenderBody()
            </main>

        </div>

    </div>

    https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.jsscript>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
